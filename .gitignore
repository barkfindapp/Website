# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment / secrets
.env
.env.local
.env.*.local

# Vercel
.vercel

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/

# Temp capture artifacts
public/screen-*-raw.png

# Raw media drop-offs (multi-MB screenshots, 150MB screen recording, mockup
# templates) must NOT be committed. Only the web-ready, resized images ship.
public/media/*
!public/media/step-*.png
!public/media/hero-*.png
!public/media/showcase-*.png
!public/media/mylo-*.png
!public/media/creator-*.jpg

# TypeScript build cache
*.tsbuildinfo

# Resources section build output (scripts/build-resources.mjs). Regenerated
# from approved content on every build, never committed.
src/data/generated/

# Licensed guide photos copied in at build time (scripts/build-resources.mjs).
public/guide-photos/
public/place-photos/
